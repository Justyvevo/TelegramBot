import asyncio
from random import random
from time import time
import aiohttp

asyncio.set_event_loop_policy(asyncio.WindowsSelectorEventLoopPolicy()) ##


import os
os.makedirs('cats', exist_ok=True)

def time_measure(func):

     def wrapper(*args, **kwargs):
          before_execute = time()
          result = func(*args, **kwargs)
          after_exectute = time()
          print(f'{func.__name__} was called for {after_exectute - before_execute}')
          return result
     return wrapper

async def download_cat(session: aiohttp.ClientSession, img_url: str, i: int):
    format = img_url[-3:]
    path = f'cats/cat{i+1}.{format}'
    if os.path.exists(path):
        return
    response = await session.get(img_url)
    img_bytes = await response.read()
    try:
        with open(path, "xb") as file:
            file.write(img_bytes)
    except FileExistsError:
        return  # Preserve files created while the download was in progress.
    print(f"cat{i+1}.{format}")



async def request():
    link = "https://api.thecatapi.com/v1/images/search?limit=10"

    session = aiohttp.ClientSession()
    response = await session.get(link)
    answer = await response.json()

    tasks = []


    for i in range(10):
        img_url = answer[i]['url']
        tasks.append(download_cat(session, img_url, i))
    await asyncio.gather(*tasks)
    
    await session.close()



@time_measure
def main():
    asyncio.run(request())

main()