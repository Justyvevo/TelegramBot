[Unit]
Description=City-level Weather Assistant
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=weatherbot
Group=weatherbot
WorkingDirectory=/opt/weather-assistant
EnvironmentFile=/etc/weather-assistant.env
ExecStart=/opt/weather-assistant/.venv/bin/python -m weather_assistant
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
